APP_NAME=rs-elisabeth
APP_ENV=local
BOOTSTRAP_EXTERNAL_WARMUP=false
BOOTSTRAP_GLOSSARY_WARMUP=false
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rs_elisabeth_web_db
DB_USERNAME=postgres
DB_PASSWORD=

# Session Driver: Gunakan 'database' di lokal, atau 'redis' di Docker production
SESSION_DRIVER=database
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
# Queue Driver: Gunakan 'sync' jika belum ada background queue worker terpisah
QUEUE_CONNECTION=sync

# Cache Store: Gunakan 'database' di lokal, atau 'redis' di Docker production
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Konfigurasi Redis (In-Memory Cache & Session)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@rs-elisabeth.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# RS Geni API (API Utama Rumah Sakit)
# ============================================================
RS_API_BASE_URL=https://latu.rs-elisabeth.com
RS_API_ENABLED=true
RS_API_KEY=
RS_API_TIMEOUT=10

# Kredensial untuk generate token baru
RS_API_USERNAME=
RS_API_PASSWORD=
RS_API_AUTH_ENDPOINT=/authentication/create_token
RS_API_TOKEN_BUFFER=60

# ============================================================
# RS MedInfras API
# ============================================================
RS_MEDIN_ENDPOINT=/medinfrasapi/rsses
RS_MEDIN_API_CONSID=
RS_MEDIN_API_SECRETKEY=

# ============================================================
# CMS API HMAC Credentials (Klien: Web Frontend)
# Digunakan untuk membuat X-Signature pada setiap request ke CMS.
# ============================================================
CMS_API_BASE_URL=http://127.0.0.1:2302/api/v1/cms
CMS_API_CONSID_WEB=WEB-FRONTEND
CMS_API_SECRET_WEB=
CMS_API_TOLERANCE_MINUTES=5
# CMS API Cache TTL in seconds (Opsional - default: 600 detik jika tidak diisi)
# CMS_CACHE_TTL_DEFAULT=600
# CMS_CACHE_TTL_NEWS=600
# CMS_CACHE_TTL_ARTICLES=600
# CMS_CACHE_TTL_PROMOTIONS=600
# CMS_CACHE_TTL_FACILITIES=600
# CMS_CACHE_TTL_ROOM_FACILITIES=600
# CMS_CACHE_TTL_BANNER_PROMOTIONS=600
# CMS_CACHE_TTL_DOCTORS=600

# ============================================================
# CMS Webhook Cache Invalidation (Penerima sinyal invalidasi dari CMS)
# ============================================================
CMS_WEBHOOK_ENABLED=true
# Kredensial autentikasi webhook (WAJIB diisi, TIDAK boleh memakai kredensial outbound CMS_API_*).
# Identitas di sini adalah identitas CMS sebagai pengirim (arah CMS -> Web).
CMS_WEBHOOK_CONSID=
CMS_WEBHOOK_SECRET=
CMS_WEBHOOK_TOLERANCE=300

# ============================================================
# CORS
# ============================================================
# Batasi domain yang bisa mengakses API. Jangan gunakan * di production!
# Contoh: https://latu.rs-elisabeth.com
CORS_ALLOWED_ORIGINS=*

VITE_APP_NAME="${APP_NAME}"

WWWUSER=1000
WWWGROUP=1000
